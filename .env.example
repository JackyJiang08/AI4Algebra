# Copy to .env. Never commit real credentials. Offline proof training is default.
# Optional paid tactic generation only; retrieval services below do not need this key.
OPENAI_API_KEY=
AI4ALGEBRA_LLM_PROVIDER=deterministic
AI4ALGEBRA_LLM_MODEL=gpt-6.2-astra
AI4ALGEBRA_LLM_BASE_URL=https://api.openai.com/v1
AI4ALGEBRA_LLM_REASONING_EFFORT=high
AI4ALGEBRA_ALLOW_PAID_API=false
AI4ALGEBRA_API_BUDGET_USD=0.50
# Use --offline on CLI commands for deterministic proposals without credentials.
# A run keeps its durable budget ledger in its output directory; reuse that
# directory and run ID on retries so previous reservations remain charged.

# Public retrieval APIs: currently keyless. Benchmark results belong in runs/, not .env.
AI4ALGEBRA_STACKS_BASE_URL=https://stacks.math.columbia.edu
# Stacks asks API users to contact its maintainers: https://stacks.math.columbia.edu/api
# Keep live Stacks requests disabled until that coordination is complete.
AI4ALGEBRA_STACKS_API_ENABLED=false
AI4ALGEBRA_LEANEXPLORE_BASE_URL=https://www.leanexplore.com/api/v2
AI4ALGEBRA_LOOGLE_BASE_URL=https://loogle.lean-lang.org
AI4ALGEBRA_API_TIMEOUT_SECONDS=20
AI4ALGEBRA_API_MAX_RESPONSE_BYTES=1048576
AI4ALGEBRA_API_RESULT_LIMIT=5
AI4ALGEBRA_API_REQUEST_INTERVAL_SECONDS=1.0
# Network retrieval requires the separate api_benchmark command's --live flag.
# No API keys for Stacks, LeanExplore, or Loogle are required by these endpoints.
