    {
      "id": "exercise-16",
      "exercise": 16,
      "title": "Recognizing elements of order two",
      "imports": ["Mathlib.GroupTheory.OrderOfElement"],
      "universes": ["u"],
      "binders": ["(G : Type u)", "[Group G]", "(x : G)"],
      "conclusion": "x ^ 2 = 1 ↔ orderOf x = 1 ∨ orderOf x = 2",
      "reference_declaration": "AI4Algebra.Benchmarks.Gold.Selected.exercise16",
      "reference_file": "AI4Algebra/Benchmarks/Gold/SelectedGroups.lean",
      "reference_imports": ["Mathlib.GroupTheory.OrderOfElement"],
      "mapping_note": "Both directions hold in any group. Lean represents infinite order by zero.",
      "forbidden_declarations": ["orderOf_eq_prime", "orderOf_eq_prime_iff", "orderOf_eq_two_iff"],
      "basic_premises": ["orderOf_dvd_iff_pow_eq_one", "Nat.dvd_prime", "Nat.prime_two", "orderOf_eq_one_iff", "pow_orderOf_eq_one"]
    },
    {
