    {
      "id": "exercise-22",
      "exercise": 22,
      "title": "Conjugation preserves order",
      "imports": ["Mathlib.GroupTheory.OrderOfElement"],
      "universes": ["u"],
      "binders": ["(G : Type u)", "[Group G]"],
      "conclusion": "(∀ x g : G, orderOf x = orderOf (g⁻¹ * x * g)) ∧ (∀ a b : G, orderOf (a * b) = orderOf (b * a))",
