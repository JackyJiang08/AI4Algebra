      "reference_file": "AI4Algebra/Benchmarks/Gold/SelectedGroups.lean",
      "reference_imports": ["Mathlib.Algebra.BigOperators.Group.List.Defs", "Mathlib.Algebra.Group.Basic"],
      "mapping_note": "List.prod is ordered and works for a noncommutative group. The empty list has product one.",
